{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": false,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "js/**/*.ts",
    "js/**/*.js",
    "admin/**/*.ts",
    "admin/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "server",
    "workers",
    "tests",
    "scripts",
    "local-proxy",
    "js/lib"
  ]
}
