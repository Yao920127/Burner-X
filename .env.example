# ===========================================
# Paper Burner X - Environment Configuration
# ===========================================

# -------------------- 資料庫配置 --------------------
DB_USER=paperburner
DB_PASSWORD=changeme_secure_password
DB_NAME=paperburner
DB_PORT=5432

# -------------------- 伺服器配置 --------------------
NODE_ENV=production
PORT=3000
APP_PORT=3000

# -------------------- 認證配置 --------------------
# ⚠️ 重要：請務必修改為強隨機金鑰
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# ⚠️ 重要：API Keys 加密金鑰（建議使用不同於 JWT_SECRET 的金鑰）
# 如果不設定，將使用 JWT_SECRET 作為後備
ENCRYPTION_SECRET=your-encryption-secret-change-in-production-min-32-chars

# -------------------- CORS 配置 --------------------
# 允許的前端域名，多個用逗號分隔
# 示例: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGIN=*

# -------------------- OCR API 配置 --------------------
# MinerU OCR 服務
MINERU_API_TOKEN=

# Doc2X OCR 服務
DOC2X_API_TOKEN=

# -------------------- 翻譯模型 API 配置 --------------------
# DeepSeek
DEEPSEEK_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Anthropic Claude
CLAUDE_API_KEY=

# 阿里雲通義千問
TONGYI_API_KEY=

# 火山引擎
VOLCANO_API_KEY=

# -------------------- Nginx 配置（可選）--------------------
NGINX_PORT=80
NGINX_SSL_PORT=443

# -------------------- 管理員賬戶（首次執行）--------------------
# 首次啟動時自動建立的管理員賬戶
ADMIN_EMAIL=admin@paperburner.local
ADMIN_PASSWORD=changeme_admin_password
ADMIN_NAME=Administrator

# -------------------- 其他配置 --------------------
# 部署模式: 'backend' | 'frontend'
DEPLOYMENT_MODE=backend

# 檔案上傳大小限制（MB）
MAX_UPLOAD_SIZE=100

# 日誌級別: 'error' | 'warn' | 'info' | 'debug'
LOG_LEVEL=info

# -------------------- Admin 統計最佳化（可選） --------------------
# 管理端統計/趨勢介面只讀限流視窗（毫秒），預設 60000
ADMIN_READ_LIMIT_WINDOW_MS=60000
# 管理端統計/趨勢介面每視窗最大請求數，預設 120
ADMIN_READ_LIMIT_MAX=120
# 管理端統計/趨勢介面快取 TTL（毫秒），預設 60000
ADMIN_STATS_CACHE_TTL_MS=60000
