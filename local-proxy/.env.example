# Paper Burner 本地代理伺服器配置
# 複製此檔案為 .env 並填入你的配置

# 伺服器埠（預設 3456）
PORT=3456

# ==================== OCR 服務 Token ====================
# 這些 Token 會被用作預設值，前端也可以透過請求頭覆蓋

# MinerU API Token（從 https://mineru.net 獲取）
MINERU_API_TOKEN=

# Doc2X API Token（從 https://doc2x.com 獲取）
DOC2X_API_TOKEN=

# ==================== 學術搜尋 API Key ====================
# 這些是可選的，沒有也能用，但有 API Key 可以提高請求限額

# Semantic Scholar API Key
SEMANTIC_SCHOLAR_API_KEY=

# PubMed API Key
PUBMED_API_KEY=
